flowchart TB
    %% Development & CI/CD
    subgraph DevEnv["Development & CI/CD"]
        Dev("Developer Workstation")
        Repo("GitHub Repository")
        subgraph Pipeline["GitHub Actions CI/CD"]
            Lint("Lint & Test")
            Build("Build Images")
            Registry("Docker Registry")
            DeployStaging("Deploy to Staging")
            E2E("Run E2E Tests")
            DeployProd("Deploy to Production")
        end
    end

    Dev -->|git push| Repo
    Repo -->|triggers| Lint
    Lint --> Build
    Build --> Registry
    Registry --> DeployStaging
    DeployStaging --> E2E
    E2E --> DeployProd

    %% Production Env
    subgraph ProdEnv["Production Environment"]
        %% Edge
        subgraph Edge["Edge Layer"]
            Cloudflare("Cloudflare\nDNS, CDN, WAF, DDoS")
        end

        %% Application
        subgraph AppLayer["Application Layer"]
            Nginx("Nginx Load Balancer\n(SSL Termination)")
            subgraph DockerNodes["Docker / PM2 Instances"]
                API1("API Server Instance 1")
                API2("API Server Instance 2")
                APIN("API Server Instance N")
            end
            Workers("BullMQ Workers\n(Multiple)")
        end

        %% Data
        subgraph DataLayer["Data Layer"]
            DBPrimary("PostgreSQL Primary\n(Managed)")
            DBReplica("PostgreSQL Read Replicas")
            Redis("Redis Cluster")
            S3("AWS S3 Storage")
        end

        %% Monitoring
        subgraph Monitoring["Monitoring & Logging"]
            Prometheus("Prometheus\n(Metrics)")
            Grafana("Grafana\n(Dashboards)")
            Sentry("Sentry\n(Error Tracking)")
            Winston("Winston Logs\n(File/Stdout)")
        end
    end

    DeployProd -.->|updates| AppLayer

    Client("End Users") -->|HTTPS| Cloudflare
    Cloudflare -->|HTTPS| Nginx
    Nginx -->|HTTP/WS| API1
    Nginx -->|HTTP/WS| API2
    Nginx -->|HTTP/WS| APIN

    DockerNodes -->|TCP| DBPrimary
    DockerNodes -->|Read| DBReplica
    DBPrimary -->|Replication| DBReplica
    DockerNodes -->|TCP| Redis
    DockerNodes -->|HTTPS| S3

    Workers -->|TCP| DBPrimary
    Workers -->|TCP| Redis
    Workers -->|HTTPS| S3

    DockerNodes -.->|Metrics| Prometheus
    Workers -.->|Metrics| Prometheus
    Prometheus --> Grafana
    DockerNodes -.->|Errors| Sentry
    DockerNodes -.->|Logs| Winston
