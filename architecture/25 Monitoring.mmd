flowchart TD
    %% Monitoring and Observability Architecture

    %% Health Checks
    subgraph HealthChecks [Health Checks & Auto-Recovery]
        direction TB
        HC_Live[Liveness: /health/live]
        HC_Ready[Readiness: /health/ready]
        HC_Startup[Startup Probe]
        
        HC_Ext[External: Uptime Robot / Cloudflare]
        
        CR_PM2[PM2: Auto-restart]
        CR_Docker[Docker: unless-stopped]
        CR_K8s[Kubernetes: Pod Restarts]
        CR_Graceful[Graceful Shutdown: Drain Connections]
        
        HC_Live -.-> CR_PM2
    end

    %% Data Collection Layer
    subgraph DataCollection [Data Collection Layer]
        direction TB
        DC_App[App Metrics: prom-client] -.->|Req rate, Latency, Errors, Queue depth| Prom_Scrape
        DC_Infra[Infra Metrics: Node exporter] -.->|CPU, Memory, Disk, Net| Prom_Scrape
        DC_DB[DB Metrics: pg_exporter] -.->|Connections, Slow queries, Bloat| Prom_Scrape
        DC_Redis[Redis Metrics: redis_exporter] -.->|Hit rate, Evictions| Prom_Scrape
        
        DC_Logs[App Logs: Winston/Morgan] -.->|JSON, Correlation IDs| Log_Forward
        DC_Errors[Error Tracking: App] -.->|Unhandled Exceptions, Perf Spans| Sentry_Forward
    end

    %% Storage & Processing
    subgraph StorageProcess [Storage & Processing]
        direction TB
        Prom[(Prometheus<br>15s scrape, 15d retention)]
        Loki[(Loki<br>Log Aggregation)]
        Sentry[(Sentry<br>Error & APM Storage)]
        
        Prom_Scrape((Scrape)) --> Prom
        Log_Forward((Forward)) --> Loki
        Sentry_Forward((Forward)) --> Sentry
    end

    %% Visualization
    subgraph Visualization [Visualization]
        direction TB
        Grafana[Grafana Dashboards]
        
        Grafana --- G_Sys[System Overview]
        Grafana --- G_App[Application Perf]
        Grafana --- G_DB[Database Perf]
        Grafana --- G_Biz[Business Metrics]
        Grafana --- G_Redis[Redis Perf]
        Grafana --- G_Queue[Queue Metrics]
        
        Prom --> Grafana
        Loki --> Grafana
    end

    %% Alerting
    subgraph Alerting [Alerting & Escalation]
        direction TB
        AlertManager[Prometheus Alertmanager]
        
        AlertManager -->|Critical: Server Down, DB down, Disk > 90%| A_Critical[Critical Alert]
        AlertManager -->|Warning: Latency > 500ms, CPU > 80%| A_Warn[Warning Alert]
        AlertManager -->|Info: Deployments, Backups| A_Info[Info Alert]
        
        A_Critical --> Esc_PD[PagerDuty / SMS]
        A_Warn --> Esc_Slack[Slack]
        A_Info --> Esc_Slack
        
        Esc_Slack -->|> 15 min Unresolved| Esc_PD
        
        Prom --> AlertManager
    end

    %% Main connections
    DataCollection --> StorageProcess
    StorageProcess --> Visualization
    StorageProcess --> Alerting
