graph TD
    %% 19 Module Dependencies

    %% Groupings
    subgraph Core["Core Multi-Tenant"]
        Auth["Auth & Identity"]
        Company["Company/Tenant"]
        Sub["Subscription"]
        Rest["Restaurant"]
        Branch["Branch"]
    end

    subgraph MenuKitchen["Menu & Kitchen"]
        Menu["Menu Management"]
        Cat["Category & Modifier"]
        Combo["Combo & Offers"]
        Rec["Recipe & Ingredient"]
        KDS["Kitchen Display (KDS)"]
    end

    subgraph OrderPay["Orders & Payments"]
        POS["POS / Billing"]
        Ord["Order Management"]
        Pay["Payment Processing"]
        Ref["Refund & Adjustments"]
        Tab["Table Management"]
        Res["Reservation"]
        QR["QR Ordering"]
        Take["Takeaway / Delivery"]
    end

    subgraph InvSupply["Inventory & Supply Chain"]
        Inv["Inventory Management"]
        PO["Purchase Order"]
        Ven["Vendor / Supplier"]
        Trans["Stock Transfer"]
        SLedger["Supplier Ledger"]
    end

    subgraph HROps["HR & Operations"]
        Emp["Employee Directory"]
        Att["Attendance Tracking"]
        Shf["Shift Management"]
        Leave["Leave Management"]
        PayR["Payroll Processing"]
        Exp["Expense Management"]
        Acc["Accounting / Ledger"]
    end

    subgraph CRM["CRM & Marketing"]
        Cust["Customer Data Platform"]
        Loyal["Loyalty Program"]
        Gift["Gift Card"]
        Coup["Coupon & Discount"]
        Mktg["Marketing Engine"]
        Notif["Notification Service"]
    end

    subgraph Analytics["Analytics & BI"]
        Rep["Standard Reports"]
        Dash["Live Dashboards"]
        BI["Custom Analytics"]
    end

    subgraph System["System & Infra"]
        Set["System Settings"]
        Print["Printer / Hardware Integration"]
        Audit["Audit Logs"]
        Act["Activity Logs"]
        API["API Keys / Webhooks"]
        Tax["Tax Engine"]
    end

    %% Dependency Arrows
    %% Soft Dependencies: -.-> (Event based / loosely coupled)
    %% Hard Dependencies: --> (Requires for core logic)
    %% Critical Infrastructure: ==> 

    %% Core Dependencies
    Company --> Auth
    Sub --> Company
    Rest --> Company
    Branch --> Rest

    %% Menu Dependencies
    Menu --> Branch
    Cat --> Menu
    Combo --> Menu
    Rec --> Menu
    KDS --> Ord

    %% Order & POS
    POS --> Branch
    POS --> Auth
    Ord --> POS
    Ord --> Menu
    Ord --> Tax
    Pay --> Ord
    Ref --> Pay
    Tab --> Branch
    Res --> Tab
    QR --> Menu
    QR --> Tab
    Take --> Ord

    %% Inventory
    Inv --> Branch
    Inv --> Rec
    PO --> Inv
    Ven --> PO
    Trans --> Inv
    SLedger --> Ven
    SLedger --> PO
    Ord -.->|Auto-Deduct Stock| Inv

    %% HR
    Emp --> Branch
    Att --> Emp
    Shf --> Att
    Leave --> Emp
    PayR --> Emp
    PayR --> Att
    PayR --> Leave
    Exp --> Branch
    Acc --> Exp
    Acc --> PayR
    Acc --> Ord
    Acc --> PO

    %% CRM
    Cust --> Company
    Loyal --> Cust
    Gift --> Cust
    Coup --> Menu
    Mktg --> Cust
    Notif --> Mktg

    %% Notifications everywhere (Soft)
    Ord -.->|Triggers| Notif
    Inv -.->|Alerts| Notif
    Att -.->|Alerts| Notif
    PayR -.->|Payslips| Notif

    %% Analytics
    Rep --> Ord
    Rep --> Inv
    Rep --> PayR
    Dash --> POS
    BI --> Rep

    %% System
    Set --> Branch
    Print --> POS
    Print --> KDS
    Audit --> Auth
    Act --> Auth
    API --> Company
    Tax --> Company
