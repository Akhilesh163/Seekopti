flowchart LR
    %% 18 Notifications Flow

    %% 1. Event Sources (Triggers)
    subgraph Sources["1. Notification Triggers (Event Sources)"]
        direction TB
        OrderE["Order Events\n(New, Ready, Done)"]
        InvE["Inventory Alerts\n(Low Stock, Expiry)"]
        AttE["Attendance Events\n(Late, Missed Clock-in)"]
        PayE["Payroll Events\n(Payslip, Payment)"]
        SubE["Subscription Events\n(Renewal, Warning)"]
        SysE["System Events\n(Downtime)"]
        MktgE["Marketing Campaigns"]
        CrmE["Customer Events\n(Loyalty, Birthday)"]
    end

    %% 2. Notification Engine
    subgraph Engine["2. Notification Engine"]
        direction TB
        EventBus(("Event Bus\n(Pub/Sub)")) 
        Rules["Lookup Notification Rules\n(Who, Which Channel, Priority)"]
        Pref["Check User Preferences"]
        Template["Template Engine\n(Inject Variables into HTML/JSON)"]
        
        EventBus --> Rules
        Rules --> Pref
        Pref --> Template
    end

    %% 4. Delivery Pipeline
    subgraph Pipeline["4. Delivery Pipeline (Routing & Queuing)"]
        direction TB
        SyncQ{"High Priority\n(Synchronous)"}
        AsyncQ{"Medium Priority\n(BullMQ Async)"}
        BatchQ{"Low Priority\n(BullMQ Scheduled)"}
    end

    %% 3. Delivery Channels
    subgraph Channels["3. Delivery Channels"]
        direction TB
        WS["WebSocket / Socket.IO\n(In-App, KDS, POS)"]
        Push["Firebase Cloud Messaging (FCM)\n(Mobile/Browser Push)"]
        Email["SMTP / Nodemailer\n(Templated Emails)"]
        SMS["Twilio / MSG91\n(Critical Alerts, OTP)"]
    end

    %% 5. Status Tracking
    subgraph Tracking["5. Status Tracking"]
        direction TB
        LogDB[(Notification Logs DB)]
        StatSent["Sent"] --> StatDeliv["Delivered"]
        StatDeliv --> StatRead["Read"]
        StatSent --> StatFailed["Failed"]
        StatFailed --> Retry{"Retry Logic\n(Max 3 attempts)"}
        Retry -- Retrying --> Pipeline
        Retry -- Max Reached --> DeadLetter["Dead Letter Queue"]
    end

    %% Wiring it all together
    Sources --> EventBus
    Template --> SyncQ
    Template --> AsyncQ
    Template --> BatchQ

    SyncQ --> WS
    SyncQ --> SMS
    
    AsyncQ --> Push
    AsyncQ --> Email
    AsyncQ --> SMS
    
    BatchQ --> Email
    BatchQ --> Push

    WS --> LogDB
    Push --> LogDB
    Email --> LogDB
    SMS --> LogDB

    LogDB -.-> StatSent
