flowchart TD
    %% 08 Tenant Isolation Strategy
    
    %% Request Entry
    subgraph ClientLayer [Client & Gateway Layer]
        req[HTTP Request] --> apiGW{API Gateway}
    end

    %% Tenant Resolution
    subgraph ResolutionLayer [Tenant Resolution Layer]
        apiGW --> extractJwt[Extract Tenant ID from JWT Claims]
        apiGW --> extractHeader[Extract X-Tenant-ID Header / API Key]
        apiGW --> extractDomain[Extract Subdomain]
        
        extractJwt --> resolver{Resolve Tenant}
        extractHeader --> resolver
        extractDomain --> resolver
    end

    %% Tenant Middleware
    subgraph MiddlewareLayer [Tenant Middleware Context]
        resolver --> |Tenant ID| validation[Validate Tenant Exists & Active]
        validation --> cacheCheck{Check Redis Cache}
        
        cacheCheck -->|Hit| attachCtx[Attach Context to Request]
        cacheCheck -->|Miss| dbCheck[Fetch Config from PostgreSQL]
        dbCheck --> cacheSet[Set Redis Cache]
        cacheSet --> attachCtx
        
        attachCtx --> route[Route to Application Controller]
    end

    %% Query Scoping & RLS
    subgraph DatabaseLayer [Data Isolation Layer (PostgreSQL)]
        route --> orm[Prisma ORM Middleware]
        
        orm -->|SELECT| q1[Append WHERE tenant_id = ?]
        orm -->|INSERT| q2[Inject tenant_id = ?]
        orm -->|UPDATE/DELETE| q3[Append WHERE tenant_id = ?]
        
        q1 & q2 & q3 --> rlsCheck{PostgreSQL RLS Engine}
        
        rlsPolicy[CREATE POLICY tenant_isolation ON table <br/> FOR ALL USING (tenant_id = current_setting('app.current_tenant')::uuid)]
        rlsPolicy -.-> rlsCheck
        
        rlsCheck -->|Pass| executeQuery[Execute Query]
        rlsCheck -->|Fail| throwErr[Throw RLS Violation Error]
    end

    %% Storage & Caching Isolation
    subgraph AncillaryIsolation [Ancillary Services Isolation]
        route --> redis[Redis Cache Isolation]
        redis -.-> |Prefixing| redisKeys[Keys: {tenant_id}:session:*, {tenant_id}:config:*]
        
        route --> s3[S3/Wasabi Storage Isolation]
        s3 -.-> |Path Isolation| s3Path[Bucket/tenant_{tenant_id}/images/*]
        
        route --> ws[WebSocket Isolation]
        ws -.-> |Socket.IO Rooms| wsRooms[Join Room: tenant_{tenant_id}_updates]
    end

    %% Enterprise Scaling
    subgraph ScaleOut [Enterprise Scale-Out Strategy]
        reqHighVolume[High Volume Tenant Detected] --> checkTier{Check Subscription Tier}
        checkTier -->|Enterprise| routeDedicated[Route to Dedicated DB Instance]
        checkTier -->|Standard| routeShared[Route to Shared Multi-Tenant DB]
        
        routeDedicated -.-> dedDB[(Dedicated PostgreSQL)]
        routeShared -.-> sharedDB[(Shared PostgreSQL with RLS)]
    end

    %% Styling
    classDef layer fill:#f9f9f9,stroke:#333,stroke-width:2px;
    classDef db fill:#dae8fc,stroke:#6c8ebf;
    classDef cache fill:#d5e8d4,stroke:#82b366;
    classDef security fill:#f8cecc,stroke:#b85450;
    
    class ClientLayer,ResolutionLayer,MiddlewareLayer,DatabaseLayer,AncillaryIsolation,ScaleOut layer;
    class rlsCheck,throwErr,rlsPolicy security;
    class sharedDB,dedDB,executeQuery db;
    class cacheCheck,cacheSet cache;
