sequenceDiagram
    autonumber
    
    actor User as User
    participant Browser as Browser
    participant ReactApp as React App
    participant APIGW as API Gateway
    participant AuthCtrl as Auth Controller
    participant AuthSvc as Auth Service
    participant UserRepo as User Repository
    participant TokenSvc as Token Service
    participant Redis as Redis Cache
    participant DB as PostgreSQL

    %% REGISTRATION FLOW
    rect rgb(240, 248, 255)
    note right of User: 1. Registration Flow
    User->>Browser: Enters signup details
    Browser->>ReactApp: Submit form
    ReactApp->>APIGW: POST /auth/register (name, email, pass)
    APIGW->>AuthCtrl: Route request
    AuthCtrl->>AuthSvc: validateRegistration()
    
    alt Validation Failed
        AuthSvc-->>AuthCtrl: Throw ValidationError
        AuthCtrl-->>ReactApp: 400 Bad Request
        ReactApp-->>User: Show Errors
    else Validation Success
        AuthSvc->>UserRepo: checkUserExists(email)
        UserRepo->>DB: SELECT id FROM users WHERE email=?
        DB-->>UserRepo: null
        AuthSvc->>AuthSvc: hashPassword(bcrypt, 10 rounds)
        AuthSvc->>UserRepo: createUser(userData, hash)
        UserRepo->>DB: INSERT INTO users
        DB-->>UserRepo: newUserId
        AuthSvc->>UserRepo: assignRole(newUserId, 'Company Admin')
        
        AuthSvc->>TokenSvc: generateTokens(newUserId, role)
        TokenSvc-->>AuthSvc: AccessToken (15m), RefreshToken (7d)
        
        AuthSvc->>Redis: storeRefreshToken(hash, expiry)
        AuthSvc-->>AuthCtrl: user, tokens
        AuthCtrl->>AuthCtrl: setCookie('refreshToken', HttpOnly)
        AuthCtrl-->>APIGW: 201 Created + AccessToken
        APIGW-->>ReactApp: tokens, userData
        ReactApp-->>Browser: Redirect to Dashboard
    end
    end

    %% LOGIN FLOW
    rect rgb(245, 245, 245)
    note right of User: 2. Login Flow
    User->>Browser: Enters credentials
    Browser->>ReactApp: Submit login form
    ReactApp->>APIGW: POST /auth/login (email, pass)
    APIGW->>AuthCtrl: Request with User-Agent & IP
    AuthCtrl->>AuthSvc: authenticate(email, pass)
    AuthSvc->>UserRepo: getUserByEmail(email)
    UserRepo->>DB: SELECT * FROM users WHERE email=?
    DB-->>UserRepo: userData + passHash
    UserRepo-->>AuthSvc: User Entity
    
    alt Account Disabled
        AuthSvc-->>AuthCtrl: Throw UnauthorizedError
        AuthCtrl-->>ReactApp: 403 Forbidden
    else Active Account
        AuthSvc->>AuthSvc: verifyPassword(pass, hash)
        alt Invalid Password
            AuthSvc-->>AuthCtrl: Throw UnauthorizedError
            AuthCtrl-->>ReactApp: 401 Unauthorized
        else Valid Password
            AuthSvc->>TokenSvc: generateTokens(id, role, permissions)
            TokenSvc-->>AuthSvc: AccessToken (15m), RefreshToken (7d)
            
            %% Device Tracking
            AuthSvc->>Redis: createSession(userId, deviceId, User-Agent, IP)
            AuthSvc->>Redis: storeRefreshToken(hash, expiry)
            
            AuthSvc-->>AuthCtrl: tokens, sessionInfo
            AuthCtrl->>AuthCtrl: setCookie('refreshToken', HttpOnly, Secure, SameSite)
            AuthCtrl-->>APIGW: 200 OK + AccessToken
            APIGW-->>ReactApp: Return AccessToken + User Data
            ReactApp->>ReactApp: Store AccessToken in Memory
        end
    end
    end

    %% TOKEN REFRESH FLOW
    rect rgb(240, 255, 240)
    note right of User: 3. Token Refresh Flow
    ReactApp->>APIGW: GET /api/protected-resource
    APIGW->>AuthCtrl: Verify AccessToken
    AuthCtrl-->>APIGW: TokenExpiredError
    APIGW-->>ReactApp: 401 Unauthorized
    
    ReactApp->>APIGW: POST /auth/refresh (includes HttpOnly Cookie)
    APIGW->>AuthCtrl: Route
    AuthCtrl->>TokenSvc: validateRefreshToken(cookie)
    
    alt Invalid/Expired Token
        TokenSvc-->>AuthCtrl: Error
        AuthCtrl-->>ReactApp: 401 (Trigger Logout)
    else Valid Token
        TokenSvc->>Redis: checkTokenRevoked(tokenId)
        Redis-->>TokenSvc: Valid
        
        %% Token Rotation
        TokenSvc->>Redis: invalidateOldToken(tokenId)
        TokenSvc->>TokenSvc: generateTokens(userId, role)
        TokenSvc->>Redis: storeNewRefreshToken(newHash)
        
        TokenSvc-->>AuthCtrl: newAccessToken, newRefreshToken
        AuthCtrl->>AuthCtrl: setCookie('refreshToken', HttpOnly)
        AuthCtrl-->>APIGW: 200 OK + newAccessToken
        APIGW-->>ReactApp: newAccessToken
        ReactApp->>APIGW: Retry GET /api/protected-resource
    end
    end

    %% MULTI-DEVICE SESSION
    rect rgb(255, 250, 240)
    note right of User: 4. Multi-Device Session Management
    ReactApp->>APIGW: GET /auth/sessions
    APIGW->>AuthSvc: getActiveSessions(userId)
    AuthSvc->>Redis: KEYS session:userId:*
    Redis-->>AuthSvc: List of active sessions
    AuthSvc-->>APIGW: Array[Session(Device, IP, LastActive)]
    APIGW-->>ReactApp: Render sessions UI
    
    User->>ReactApp: Click "Revoke Session" (deviceId)
    ReactApp->>APIGW: POST /auth/revoke-session (deviceId)
    APIGW->>AuthSvc: revokeSession(userId, deviceId)
    AuthSvc->>Redis: DEL session:userId:deviceId
    AuthSvc->>Redis: SADD revoked_tokens (all tokens for device)
    AuthSvc-->>APIGW: Success
    APIGW-->>ReactApp: Session Terminated
    end

    %% RBAC CHECK FLOW
    rect rgb(255, 240, 245)
    note right of User: 5. RBAC & Permissions Check
    ReactApp->>APIGW: POST /api/inventory (Bearer AccessToken)
    APIGW->>AuthCtrl: AuthMiddleware
    AuthCtrl->>TokenSvc: verifyAccessToken()
    TokenSvc-->>AuthCtrl: Decoded Payload (userId, role, tenantId)
    
    AuthCtrl->>AuthSvc: checkPermission(role, 'CREATE_INVENTORY')
    AuthSvc->>Redis: HGET role_permissions:role 'CREATE_INVENTORY'
    
    alt Permission Missing
        Redis-->>AuthSvc: false
        AuthSvc-->>AuthCtrl: Error
        AuthCtrl-->>APIGW: 403 Forbidden (Insufficient Permissions)
    else Permission Exists
        Redis-->>AuthSvc: true
        AuthSvc-->>AuthCtrl: Allowed
        AuthCtrl->>APIGW: Proceed to Controller
    end
    end
