flowchart TD
    %% 17 Expenses Management Flow

    %% 1. Expense Recording
    subgraph Entry["1 & 2. Expense Recording & Categories"]
        direction TB
        Start((Start)) --> SelectCat["Select Category"]
        SelectCat --> EnterDetails["Enter Amount, Date, Vendor, Desc"]
        EnterDetails --> AttachReceipt["Attach Receipt (S3 Upload)"]
        AttachReceipt --> SelectPayment["Select Payment Method"]
        SelectPayment --> SubmitExp["Submit Expense Record"]
        
        noteCat[Categories: Rent, Utilities, Raw Materials,\nEquipment, Marketing, Salary,\nMaintenance, Transport, Licensing, Misc]
        SelectCat -.-> noteCat
    end

    %% 3. Approval Workflow
    subgraph Approval["3. Approval Workflow"]
        direction TB
        SubmitExp --> CheckAmount{"Check Amount"}
        
        CheckAmount -- "< ₹5,000" --> AutoApp["Auto-Approved"]
        CheckAmount -- "₹5,000 - ₹50,000" --> BranchMgrApp{"Branch Manager Approval"}
        CheckAmount -- "> ₹50,000" --> OwnerApp{"Restaurant Owner Approval"}
        
        BranchMgrApp -- Approve --> BranchApp["Approved by Branch Mgr"]
        BranchMgrApp -- Reject --> RejectNode["Rejected"]
        
        OwnerApp -- Approve --> OwnApp["Approved by Owner"]
        OwnerApp -- Reject --> RejectNode
        
        AutoApp --> FinalApp["Mark as APPROVED"]
        BranchApp --> FinalApp
        OwnApp --> FinalApp
        
        RejectNode --> NotifyReject["Notify Submitter w/ Reason"]
    end

    %% 4 & 5. Recurring & Petty Cash
    subgraph FinanceOps["4 & 5. Recurring & Petty Cash Ops"]
        direction TB
        CronJob(("Monthly Cron")) --> GenRecurring["Auto-create Recurring Entries\n(Rent, Utilities, Subscriptions)"]
        GenRecurring --> SubmitExp
        
        ReqPetty["Request Petty Cash Replenishment"] --> BranchMgrApp
        Disburse["Petty Cash Disbursement Tracking"] --> EndOfDayRecon{"Daily Reconciliation"}
        EndOfDayRecon -- Match --> ReconSuccess["Ledger Updated"]
        EndOfDayRecon -- Mismatch --> FlagDiscrep["Flag for Audit"]
    end

    %% 6. Reporting & Integration
    subgraph Reporting["6. Reporting & Integration"]
        direction TB
        FinalApp --> UpdateLedger["Update Branch Ledger"]
        UpdateLedger --> PnLSync["Sync with P&L / Accounting Module"]
        
        PnLSync --> Dashboards["Generate Dashboards:\n- Category-wise Breakdown\n- Branch Comparison\n- Budget vs Actual"]
    end

    %% Links
    FinalApp -.-> Disburse
