flowchart TB
    %% Core System
    System("RestroCloud Platform\n[Software System]")

    %% Actors
    subgraph Actors["People / Actors"]
        RestOwner("Restaurant Owner")
        BranchMgr("Branch Manager")
        Cashier("Cashier")
        KitchenStaff("Kitchen Staff")
        Waiter("Waiter")
        Customer("Customer")
        QRGuest("QR Guest")
        PlatformAdmin("Platform Admin")
        SupportExec("Support Executive")
    end

    %% External Systems
    subgraph External["External Systems"]
        PayGateway("Payment Gateways\n(Razorpay, Stripe)")
        SMS("SMS Provider\n(Twilio, MSG91)")
        Email("Email Service\n(SMTP)")
        Push("Push Notification\n(FCM)")
        CloudStorage("Cloud Storage\n(AWS S3)")
        Delivery("Delivery Platforms\n(Swiggy, Zomato, UberEats)")
        Accounting("Accounting Software\n(Tally, QuickBooks)")
        Analytics("Analytics Platform")
    end

    %% Relationships - Actors to System
    RestOwner -->|Manages global settings, views reports| System
    BranchMgr -->|Manages branch operations| System
    Cashier -->|Processes billing, orders| System
    KitchenStaff -->|Views KDS, updates order status| System
    Waiter -->|Takes orders via captain app| System
    Customer -->|Views menu, orders online| System
    QRGuest -->|Scans QR, orders from table| System
    PlatformAdmin -->|Manages SaaS platform, tenants| System
    SupportExec -->|Provides technical support| System

    %% Relationships - System to External
    System -->|Processes payments| PayGateway
    System -->|Sends SMS alerts| SMS
    System -->|Sends email reports/receipts| Email
    System -->|Sends push notifications| Push
    System -->|Uploads/Retrieves files| CloudStorage
    System <-->|Syncs orders, menus| Delivery
    System -->|Syncs financial data| Accounting
    System -->|Sends telemetry/analytics| Analytics
