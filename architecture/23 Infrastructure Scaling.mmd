flowchart TD
    %% Tiers Progression
    T1[Tier 1: 100 Restaurants] -->|Scaling Triggers:<br>CPU > 70%<br>DB Connections > 80%| T2[Tier 2: 1,000 Restaurants]
    T2 -->|Scaling Triggers:<br>Response Time > 500ms<br>Storage > 80%| T3[Tier 3: 10,000 Restaurants]
    T3 -->|Scaling Triggers:<br>Multi-Region Demand<br>Enterprise Tenants| T4[Tier 4: 100,000 Restaurants]

    subgraph Tier1 [Tier 1: 100 Restaurants - Startup Phase]
        direction TB
        T1_LB[Cloudflare CDN] --> T1_API[1 API Server: PM2, 4 Workers]
        T1_API --> T1_DB[(PostgreSQL: 1 Instance, 2 vCPU, 8GB RAM)]
        T1_API --> T1_Redis[(Redis: 1 Instance, 1GB)]
        T1_API --> T1_Queue[1 BullMQ Worker]
        T1_API -.-> T1_Storage[S3 Storage]
        T1_Cost[Cost: ~$500-800/mo]
    end

    subgraph Tier2 [Tier 2: 1,000 Restaurants - Growth Phase]
        direction TB
        T2_LB[Cloudflare CDN] --> T2_Nginx[Nginx Load Balancer]
        T2_Nginx --> T2_API1[API Server 1]
        T2_Nginx --> T2_API2[API Server 2]
        T2_Nginx --> T2_WS[Dedicated WebSocket Server]
        
        T2_API1 --> T2_PgB[PgBouncer]
        T2_API2 --> T2_PgB
        
        T2_PgB --> T2_DB_Primary[(PostgreSQL Primary: 4 vCPU, 16GB)]
        T2_DB_Primary -->|Replication| T2_DB_Read[(PostgreSQL Read Replica)]
        
        T2_API1 --> T2_Redis[(Redis Cluster: 3 Nodes)]
        T2_API2 --> T2_Redis
        
        T2_Worker1[BullMQ Worker 1] --> T2_Redis
        T2_Worker2[BullMQ Worker 2] --> T2_Redis
        T2_Cost[Cost: ~$2,500-4,000/mo]
    end

    subgraph Tier3 [Tier 3: 10,000 Restaurants - Scale Phase]
        direction TB
        T3_CDN[CDN Static Assets] --> T3_ALB[Load Balancer]
        T3_ALB --> T3_API_Group[5-10 API Servers: Auto-Scaling]
        
        T3_API_Group --> T3_Micro_Begin[Dedicated Services:<br>Auth, Orders, Notifications]
        
        T3_API_Group --> T3_DB_Primary[(PostgreSQL Primary: 8 vCPU, 32GB)]
        T3_DB_Primary -->|Replication| T3_DB_Read1[(Read Replica 1)]
        T3_DB_Primary -->|Replication| T3_DB_Read2[(Read Replica 2)]
        T3_DB_Primary -->|Replication| T3_DB_Read3[(Read Replica 3)]
        T3_DB_Primary -.-> T3_Part[Table Partitioning: Orders, Logs]
        
        T3_API_Group --> T3_Redis[(Redis Cluster: 6 Nodes)]
        
        T3_Workers[5+ Specialized BullMQ Workers] --> T3_Redis
        T3_Cost[Cost: ~$15,000-25,000/mo]
        T3_AZ[Multi-AZ Deployment]
    end

    subgraph Tier4 [Tier 4: 100,000 Restaurants - Enterprise Phase]
        direction TB
        T4_Global_CDN[Global CDN Edge Caching] --> T4_API_Gateway[API Gateway: Kong/Custom]
        T4_API_Gateway --> T4_K8s[Kubernetes Cluster: Auto-Scaling, 20-50 Pods]
        
        T4_K8s --> T4_Service_Mesh[Service Mesh]
        
        T4_Service_Mesh --> T4_DB_Sharded[(PostgreSQL: Sharded by tenant_id)]
        T4_Service_Mesh --> T4_DB_Enterprise[(Dedicated DB for Enterprise)]
        
        T4_Service_Mesh --> T4_Event_Bus[Event Broker: Kafka/RabbitMQ]
        
        T4_Event_Bus --> T4_Worker_Pools[Worker Pools per Job Type]
        T4_K8s --> T4_Redis[(Redis Cluster: 12+ Nodes)]
        
        T4_Cost[Cost: ~$100,000-180,000/mo]
        T4_Region[Multi-Region Deployment]
    end

    %% Microservices Migration Path
    subgraph MicroservicesPath [Migration Path to Microservices]
        direction LR
        M1[Monolith] --> M2[Modular Monolith]
        M2 --> M3[Extract Auth Service]
        M3 --> M4[Extract Notification Service]
        M4 --> M5[Extract Order Service]
        M5 --> M6[Extract Inventory Service]
        M6 --> M7[Full Microservices Architecture]
    end

    classDef default fill:#f9f9f9,stroke:#333,stroke-width:1px;
    classDef tier fill:#e1f5fe,stroke:#0288d1,stroke-width:2px;
    classDef trigger fill:#fff3e0,stroke:#f57c00,stroke-width:1px,stroke-dasharray: 5 5;
    
    class Tier1,Tier2,Tier3,Tier4 tier;
