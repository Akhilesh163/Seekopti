Project "Seek Your Y Restaurant Management System" {
  database_type: 'PostgreSQL'
  Note: '''
    # Comprehensive Multi-Tenant Restaurant Management System Schema
    Target Scale: 100k+ restaurants
    Architecture: Shared Database, Shared Schema with tenant_id (Row-Level Security)
  '''
}

// ==========================================
// ENUMS
// ==========================================

Enum order_status {
  PLACED
  CONFIRMED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

Enum payment_method {
  CASH
  CARD
  UPI
  WALLET
  BANK_TRANSFER
}

Enum payment_status {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

Enum order_type {
  DINE_IN
  TAKEAWAY
  DELIVERY
  QR_ORDER
  ONLINE
}

Enum subscription_status {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

Enum attendance_status {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
}

Enum expense_status {
  PENDING
  APPROVED
  REJECTED
  PAID
}

Enum stock_movement_type {
  PURCHASE
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  WASTE
}

Enum notification_channel {
  IN_APP
  PUSH
  EMAIL
  SMS
}

Enum kot_status {
  NEW
  IN_PROGRESS
  READY
  SERVED
  CANCELLED
}

Enum reservation_status {
  PENDING
  CONFIRMED
  SEATED
  CANCELLED
  NO_SHOW
}

Enum table_status {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  MAINTENANCE
}

// ==========================================
// TABLES
// ==========================================

// --- Core / Multi-Tenant ---

Table companies {
  id uuid [primary key, note: 'UUID v4']
  name varchar(255) [not null]
  domain varchar(255) [unique]
  contact_email varchar(255)
  contact_phone varchar(50)
  tax_id varchar(100)
  address text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp
  is_active boolean [default: true]
  Note: 'SaaS platform owner entity. Tenants belong to companies.'
}

Table subscription_plans {
  id uuid [primary key]
  name varchar(100) [not null]
  description text
  price_monthly decimal(10,2) [not null]
  price_yearly decimal(10,2) [not null]
  features jsonb
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp
  is_active boolean [default: true]
}

Table subscriptions {
  id uuid [primary key]
  company_id uuid [not null]
  plan_id uuid [not null]
  status subscription_status [not null, default: 'TRIAL']
  start_date date [not null]
  end_date date [not null]
  trial_ends_at date
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp
  is_active boolean [default: true]
}

Table subscription_invoices {
  id uuid [primary key]
  subscription_id uuid [not null]
  amount decimal(10,2) [not null]
  invoice_date date [not null]
  due_date date [not null]
  status payment_status [not null, default: 'PENDING']
  invoice_url text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp
}

Table restaurants {
  id uuid [primary key, note: 'This is the primary tenant_id']
  company_id uuid [not null]
  name varchar(255) [not null]
  currency varchar(10) [default: 'USD']
  timezone varchar(100) [default: 'UTC']
  logo_url text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
  updated_by uuid
  deleted_at timestamp
  is_active boolean [default: true]
  Note: 'Tenant entity - source of tenant_id for RLS'
}

Table branches {
  id uuid [primary key]
  tenant_id uuid [not null]
  name varchar(255) [not null]
  code varchar(50)
  address text
  city varchar(100)
  state varchar(100)
  country varchar(100)
  postal_code varchar(20)
  contact_number varchar(50)
  email varchar(255)
  manager_id uuid
  is_central_kitchen boolean [default: false]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
  updated_by uuid
  deleted_at timestamp
  is_active boolean [default: true]
}

Table departments {
  id uuid [primary key]
  tenant_id uuid [not null]
  branch_id uuid [not null]
  name varchar(100) [not null]
  code varchar(50)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
  updated_by uuid
  deleted_at timestamp
  is_active boolean [default: true]
}

// --- Auth & RBAC ---

Table users {
  id uuid [primary key]
  tenant_id uuid
  email varchar(255) [unique, not null]
  phone_number varchar(50)
  password_hash varchar(255)
  first_name varchar(100)
  last_name varchar(100)
  last_login_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp
  is_active boolean [default: true]
  Note: 'Contains all users (Super Admins to Employees)'
}

Table roles {
  id uuid [primary key]
  tenant_id uuid
  name varchar(100) [not null]
  description text
  is_system boolean [default: false]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
  updated_by uuid
  deleted_at timestamp
  is_active boolean [default: true]
}

Table permissions {
  id uuid [primary key]
  module varchar(100) [not null]
  action varchar(100) [not null]
  description text
  Note: 'e.g., module: orders, action: create'
}

Table role_permissions {
  id uuid [primary key]
  role_id uuid [not null]
  permission_id uuid [not null]
}

Table user_roles {
  id uuid [primary key]
  user_id uuid [not null]
  role_id uuid [not null]
  branch_id uuid
  Note: 'Users can have roles scoped to specific branches'
}

Table sessions {
  id uuid [primary key]
  user_id uuid [not null]
  token varchar(512) [not null]
  device_info text
  ip_address varchar(45)
  expires_at timestamp [not null]
  created_at timestamp [not null, default: `now()`]
}

Table refresh_tokens {
  id uuid [primary key]
  user_id uuid [not null]
  token varchar(512) [not null]
  expires_at timestamp [not null]
  revoked_at timestamp
  created_at timestamp [not null, default: `now()`]
}

Table password_reset_tokens {
  id uuid [primary key]
  user_id uuid [not null]
  token varchar(512) [not null]
  expires_at timestamp [not null]
  used_at timestamp
  created_at timestamp [not null, default: `now()`]
}

Table api_keys {
  id uuid [primary key]
  tenant_id uuid [not null]
  name varchar(100) [not null]
  key_hash varchar(255) [not null]
  expires_at timestamp
  last_used_at timestamp
  created_at timestamp [not null, default: `now()`]
  created_by uuid
  is_active boolean [default: true]
}

// --- Menu ---

Table categories {
  id uuid [primary key]
  tenant_id uuid [not null]
  parent_id uuid
  name varchar(100) [not null]
  description text
  display_order int
  image_url text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
  updated_by uuid
  deleted_at timestamp
  is_active boolean [default: true]
}

Table menu_items {
  id uuid [primary key]
  tenant_id uuid [not null]
  category_id uuid [not null]
  name varchar(255) [not null]
  short_name varchar(100)
  description text
  sku varchar(100)
  barcode varchar(100)
  base_price decimal(10,2) [not null, default: 0]
  is_veg boolean [default: true]
  spiciness_level int [default: 0]
  preparation_time_mins int
  calories int
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
  updated_by uuid
  deleted_at timestamp
  is_active boolean [default: true]
}

Table menu_item_branches {
  id uuid [primary key]
  tenant_id uuid [not null]
  menu_item_id uuid [not null]
  branch_id uuid [not null]
  price decimal(10,2)
  is_available boolean [default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  Note: 'Branch-specific pricing and availability overrides'
}

Table modifier_groups {
  id uuid [primary key]
  tenant_id uuid [not null]
  name varchar(100) [not null]
  min_selection int [default: 0]
  max_selection int
  is_required boolean [default: false]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp
  is_active boolean [default: true]
}

Table modifiers {
  id uuid [primary key]
  tenant_id uuid [not null]
  modifier_group_id uuid [not null]
  name varchar(100) [not null]
  price decimal(10,2) [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp
  is_active boolean [default: true]
}

Table menu_item_modifiers {
  id uuid [primary key]
  tenant_id uuid [not null]
  menu_item_id uuid [not null]
  modifier_group_id uuid [not null]
}

Table combo_meals {
  id uuid [primary key]
  tenant_id uuid [not null]
  name varchar(255) [not null]
  description text
  price decimal(10,2) [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp
  is_active boolean [default: true]
}

Table combo_items {
  id uuid [primary key]
  tenant_id uuid [not null]
  combo_meal_id uuid [not null]
  menu_item_id uuid [not null]
  quantity int [not null, default: 1]
  is_optional boolean [default: false]
}

Table item_images {
  id uuid [primary key]
  tenant_id uuid [not null]
  menu_item_id uuid [not null]
  image_url text [not null]
  display_order int
  created_at timestamp [not null, default: `now()`]
}

// --- Recipe & Ingredients ---

Table ingredient_categories {
  id uuid [primary key]
  tenant_id uuid [not null]
  name varchar(100) [not null]
  description text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp
  is_active boolean [default: true]
}

Table ingredients {
  id uuid [primary key]
  tenant_id uuid [not null]
  category_id uuid
  name varchar(255) [not null]
  code varchar(100)
  unit_of_measure varchar(50) [not null]
  cost_per_unit decimal(10,4)
  yield_percentage decimal(5,2) [default: 100]
  minimum_stock_level decimal(10,2)
  maximum_stock_level decimal(10,2)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
  updated_by uuid
  deleted_at timestamp
  is_active boolean [default: true]
}

Table recipes {
  id uuid [primary key]
  tenant_id uuid [not null]
  menu_item_id uuid [not null]
  name varchar(255)
  instructions text
  preparation_time_mins int
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
  updated_by uuid
  deleted_at timestamp
  is_active boolean [default: true]
}

Table recipe_ingredients {
  id uuid [primary key]
  tenant_id uuid [not null]
  recipe_id uuid [not null]
  ingredient_id uuid [not null]
  quantity decimal(10,4) [not null]
  unit_of_measure varchar(50) [not null]
  is_optional boolean [default: false]
}

// --- Inventory ---

Table inventory_items {
  id uuid [primary key]
  tenant_id uuid [not null]
  branch_id uuid [not null]
  ingredient_id uuid [not null]
  current_quantity decimal(10,4) [not null, default: 0]
  reorder_level decimal(10,4)
  last_counted_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  Note: 'Tracks stock levels per branch'
}

Table inventory_transactions {
  id uuid [primary key]
  tenant_id uuid [not null]
  branch_id uuid [not null]
  ingredient_id uuid [not null]
  movement_type stock_movement_type [not null]
  quantity_changed decimal(10,4) [not null]
  unit_cost decimal(10,4)
  reference_id uuid
  reference_type varchar(50)
  notes text
  created_at timestamp [not null, default: `now()`]
  created_by uuid
  Note: 'Immutable log of all stock movements. Partition by created_at (monthly)'
}

Table purchase_orders {
  id uuid [primary key]
  tenant_id uuid [not null]
  branch_id uuid [not null]
  vendor_id uuid [not null]
  po_number varchar(100) [not null]
  status varchar(50) [not null, default: 'DRAFT']
  expected_delivery_date date
  total_amount decimal(10,2)
  notes text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
  updated_by uuid
  deleted_at timestamp
}

Table purchase_order_items {
  id uuid [primary key]
  tenant_id uuid [not null]
  purchase_order_id uuid [not null]
  ingredient_id uuid [not null]
  quantity decimal(10,4) [not null]
  unit_price decimal(10,4) [not null]
  total_price decimal(10,2) [not null]
}

Table goods_received_notes {
  id uuid [primary key]
  tenant_id uuid [not null]
  branch_id uuid [not null]
  purchase_order_id uuid
  vendor_id uuid [not null]
  grn_number varchar(100) [not null]
  invoice_number varchar(100)
  received_date timestamp [not null]
  total_amount decimal(10,2)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
  updated_by uuid
}

Table grn_items {
  id uuid [primary key]
  tenant_id uuid [not null]
  grn_id uuid [not null]
  ingredient_id uuid [not null]
  ordered_quantity decimal(10,4)
  received_quantity decimal(10,4) [not null]
  accepted_quantity decimal(10,4) [not null]
  rejected_quantity decimal(10,4) [default: 0]
  unit_price decimal(10,4) [not null]
}

Table stock_transfers {
  id uuid [primary key]
  tenant_id uuid [not null]
  source_branch_id uuid [not null]
  destination_branch_id uuid [not null]
  transfer_number varchar(100) [not null]
  status varchar(50) [not null, default: 'PENDING']
  dispatched_at timestamp
  received_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
  updated_by uuid
}

Table stock_transfer_items {
  id uuid [primary key]
  tenant_id uuid [not null]
  stock_transfer_id uuid [not null]
  ingredient_id uuid [not null]
  quantity decimal(10,4) [not null]
  received_quantity decimal(10,4)
}

Table stock_adjustments {
  id uuid [primary key]
  tenant_id uuid [not null]
  branch_id uuid [not null]
  adjustment_number varchar(100)
  reason varchar(255)
  status varchar(50) [default: 'COMPLETED']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
}

Table waste_logs {
  id uuid [primary key]
  tenant_id uuid [not null]
  branch_id uuid [not null]
  ingredient_id uuid
  menu_item_id uuid
  quantity decimal(10,4) [not null]
  reason text
  cost_impact decimal(10,2)
  logged_at timestamp [not null, default: `now()`]
  created_by uuid
}

// --- Vendor ---

Table vendors {
  id uuid [primary key]
  tenant_id uuid [not null]
  name varchar(255) [not null]
  code varchar(100)
  tax_id varchar(100)
  address text
  city varchar(100)
  state varchar(100)
  country varchar(100)
  postal_code varchar(20)
  payment_terms varchar(255)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
  updated_by uuid
  deleted_at timestamp
  is_active boolean [default: true]
}

Table vendor_contacts {
  id uuid [primary key]
  tenant_id uuid [not null]
  vendor_id uuid [not null]
  name varchar(100) [not null]
  email varchar(255)
  phone varchar(50)
  is_primary boolean [default: false]
}

Table supplier_ledger_entries {
  id uuid [primary key]
  tenant_id uuid [not null]
  vendor_id uuid [not null]
  transaction_type varchar(50) [not null]
  amount decimal(10,2) [not null]
  reference_id uuid
  description text
  entry_date timestamp [not null, default: `now()`]
  created_at timestamp [not null, default: `now()`]
  created_by uuid
}

// --- Orders ---

Table orders {
  id uuid [primary key]
  tenant_id uuid [not null]
  branch_id uuid [not null]
  customer_id uuid
  table_id uuid
  employee_id uuid
  order_number varchar(100) [not null]
  status order_status [not null, default: 'PLACED']
  order_type order_type [not null]
  guest_count int
  subtotal decimal(10,2) [not null, default: 0]
  tax_total decimal(10,2) [not null, default: 0]
  discount_total decimal(10,2) [not null, default: 0]
  service_charge decimal(10,2) [not null, default: 0]
  grand_total decimal(10,2) [not null, default: 0]
  notes text
  placed_at timestamp [not null, default: `now()`]
  completed_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
  updated_by uuid
  deleted_at timestamp
  Note: 'Partition by created_at (monthly). Archive after 1 year.'
}

Table order_items {
  id uuid [primary key]
  tenant_id uuid [not null]
  order_id uuid [not null]
  menu_item_id uuid [not null]
  quantity int [not null, default: 1]
  unit_price decimal(10,2) [not null]
  subtotal decimal(10,2) [not null]
  discount_amount decimal(10,2) [default: 0]
  tax_amount decimal(10,2) [default: 0]
  total decimal(10,2) [not null]
  notes text
  status kot_status [default: 'NEW']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table order_item_modifiers {
  id uuid [primary key]
  tenant_id uuid [not null]
  order_item_id uuid [not null]
  modifier_id uuid [not null]
  quantity int [not null, default: 1]
  price decimal(10,2) [not null]
}

Table order_status_history {
  id uuid [primary key]
  tenant_id uuid [not null]
  order_id uuid [not null]
  status order_status [not null]
  notes text
  created_at timestamp [not null, default: `now()`]
  created_by uuid
}

Table kot_tickets {
  id uuid [primary key]
  tenant_id uuid [not null]
  branch_id uuid [not null]
  order_id uuid [not null]
  ticket_number varchar(100) [not null]
  status kot_status [not null, default: 'NEW']
  printed_at timestamp
  completed_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
}

Table kot_items {
  id uuid [primary key]
  tenant_id uuid [not null]
  kot_ticket_id uuid [not null]
  order_item_id uuid [not null]
  status kot_status [not null, default: 'NEW']
}

// --- Billing & Payments ---

Table bills {
  id uuid [primary key]
  tenant_id uuid [not null]
  branch_id uuid [not null]
  order_id uuid [not null]
  bill_number varchar(100) [not null]
  subtotal decimal(10,2) [not null]
  tax_amount decimal(10,2) [not null]
  discount_amount decimal(10,2) [not null]
  service_charge decimal(10,2) [not null]
  total_amount decimal(10,2) [not null]
  amount_paid decimal(10,2) [not null, default: 0]
  amount_due decimal(10,2) [not null]
  status payment_status [not null, default: 'PENDING']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
  updated_by uuid
}

Table bill_items {
  id uuid [primary key]
  tenant_id uuid [not null]
  bill_id uuid [not null]
  order_item_id uuid [not null]
  amount decimal(10,2) [not null]
}

Table payments {
  id uuid [primary key]
  tenant_id uuid [not null]
  branch_id uuid [not null]
  bill_id uuid [not null]
  payment_method payment_method [not null]
  amount decimal(10,2) [not null]
  transaction_reference varchar(255)
  status payment_status [not null, default: 'COMPLETED']
  payment_date timestamp [not null, default: `now()`]
  created_at timestamp [not null, default: `now()`]
  created_by uuid
}

Table payment_splits {
  id uuid [primary key]
  tenant_id uuid [not null]
  bill_id uuid [not null]
  payment_id uuid [not null]
  amount decimal(10,2) [not null]
}

Table refunds {
  id uuid [primary key]
  tenant_id uuid [not null]
  branch_id uuid [not null]
  payment_id uuid [not null]
  amount decimal(10,2) [not null]
  reason text
  status payment_status [not null, default: 'COMPLETED']
  created_at timestamp [not null, default: `now()`]
  created_by uuid
}

Table credit_notes {
  id uuid [primary key]
  tenant_id uuid [not null]
  branch_id uuid [not null]
  customer_id uuid [not null]
  credit_number varchar(100)
  amount decimal(10,2) [not null]
  balance decimal(10,2) [not null]
  reason text
  expires_at timestamp
  created_at timestamp [not null, default: `now()`]
  created_by uuid
}

// --- Tax ---

Table tax_groups {
  id uuid [primary key]
  tenant_id uuid [not null]
  name varchar(100) [not null]
  description text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp
  is_active boolean [default: true]
}

Table taxes {
  id uuid [primary key]
  tenant_id uuid [not null]
  tax_group_id uuid [not null]
  name varchar(100) [not null]
  rate decimal(5,2) [not null]
  type varchar(50) [default: 'PERCENTAGE']
  is_inclusive boolean [default: false]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp
  is_active boolean [default: true]
}

Table menu_item_taxes {
  id uuid [primary key]
  tenant_id uuid [not null]
  menu_item_id uuid [not null]
  tax_group_id uuid [not null]
}

Table tax_configurations {
  id uuid [primary key]
  tenant_id uuid [not null]
  branch_id uuid [not null]
  tax_group_id uuid [not null]
  registration_number varchar(100)
}

// --- Discounts & Promotions ---

Table discounts {
  id uuid [primary key]
  tenant_id uuid [not null]
  name varchar(100) [not null]
  type varchar(50) [not null, note: 'PERCENTAGE, FIXED']
  value decimal(10,2) [not null]
  max_discount_amount decimal(10,2)
  min_order_amount decimal(10,2)
  start_date timestamp
  end_date timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
  deleted_at timestamp
  is_active boolean [default: true]
}

Table coupons {
  id uuid [primary key]
  tenant_id uuid [not null]
  discount_id uuid [not null]
  code varchar(50) [not null, unique]
  usage_limit int
  usage_count int [default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  is_active boolean [default: true]
}

Table coupon_usage {
  id uuid [primary key]
  tenant_id uuid [not null]
  coupon_id uuid [not null]
  order_id uuid [not null]
  customer_id uuid
  discount_applied decimal(10,2) [not null]
  used_at timestamp [not null, default: `now()`]
}

Table loyalty_programs {
  id uuid [primary key]
  tenant_id uuid [not null]
  name varchar(100) [not null]
  points_per_currency decimal(10,2) [not null]
  currency_per_point decimal(10,2) [not null]
  minimum_points_to_redeem int [default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  is_active boolean [default: true]
}

Table loyalty_tiers {
  id uuid [primary key]
  tenant_id uuid [not null]
  loyalty_program_id uuid [not null]
  name varchar(100) [not null]
  min_points int [not null]
  multiplier decimal(5,2) [default: 1.0]
}

Table loyalty_transactions {
  id uuid [primary key]
  tenant_id uuid [not null]
  customer_id uuid [not null]
  order_id uuid
  points int [not null]
  transaction_type varchar(50) [not null, note: 'EARN, REDEEM, EXPIRE']
  description text
  created_at timestamp [not null, default: `now()`]
}

Table gift_cards {
  id uuid [primary key]
  tenant_id uuid [not null]
  code varchar(100) [not null, unique]
  initial_balance decimal(10,2) [not null]
  current_balance decimal(10,2) [not null]
  issue_date timestamp [not null, default: `now()`]
  expiry_date timestamp
  purchaser_customer_id uuid
  recipient_email varchar(255)
  is_active boolean [default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table gift_card_transactions {
  id uuid [primary key]
  tenant_id uuid [not null]
  gift_card_id uuid [not null]
  order_id uuid
  amount decimal(10,2) [not null]
  transaction_type varchar(50) [not null, note: 'ISSUE, REDEEM, REFUND']
  created_at timestamp [not null, default: `now()`]
}

// --- Tables & Reservations ---

Table table_sections {
  id uuid [primary key]
  tenant_id uuid [not null]
  branch_id uuid [not null]
  name varchar(100) [not null]
  description text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp
  is_active boolean [default: true]
}

Table tables {
  id uuid [primary key]
  tenant_id uuid [not null]
  section_id uuid [not null]
  name varchar(50) [not null]
  capacity int [not null]
  status table_status [default: 'AVAILABLE']
  pos_x int
  pos_y int
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp
  is_active boolean [default: true]
}

Table reservations {
  id uuid [primary key]
  tenant_id uuid [not null]
  branch_id uuid [not null]
  customer_id uuid
  table_id uuid
  reservation_time timestamp [not null]
  guest_count int [not null]
  status reservation_status [not null, default: 'PENDING']
  special_requests text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
  updated_by uuid
}

Table waitlist {
  id uuid [primary key]
  tenant_id uuid [not null]
  branch_id uuid [not null]
  customer_id uuid
  guest_name varchar(100) [not null]
  phone_number varchar(50) [not null]
  guest_count int [not null]
  quoted_time_mins int
  status varchar(50) [default: 'WAITING', note: 'WAITING, SEATED, CANCELLED']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table qr_codes {
  id uuid [primary key]
  tenant_id uuid [not null]
  table_id uuid
  code varchar(255) [not null, unique]
  url text [not null]
  type varchar(50) [not null, note: 'TABLE, GENERAL']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  is_active boolean [default: true]
}

// --- Customer ---

Table customers {
  id uuid [primary key]
  tenant_id uuid [not null]
  first_name varchar(100)
  last_name varchar(100)
  email varchar(255)
  phone_number varchar(50)
  date_of_birth date
  loyalty_points int [default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp
  is_active boolean [default: true]
}

Table customer_addresses {
  id uuid [primary key]
  tenant_id uuid [not null]
  customer_id uuid [not null]
  label varchar(50)
  address_line1 text [not null]
  address_line2 text
  city varchar(100)
  state varchar(100)
  postal_code varchar(20)
  country varchar(100)
  latitude decimal(10,8)
  longitude decimal(11,8)
  is_default boolean [default: false]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table customer_preferences {
  id uuid [primary key]
  tenant_id uuid [not null]
  customer_id uuid [not null]
  dietary_restrictions text[]
  favorite_items uuid[]
  marketing_opt_in boolean [default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table customer_feedback {
  id uuid [primary key]
  tenant_id uuid [not null]
  customer_id uuid
  order_id uuid
  rating int [not null]
  comments text
  created_at timestamp [not null, default: `now()`]
}

// --- Employee & HR ---

Table employees {
  id uuid [primary key]
  tenant_id uuid [not null]
  user_id uuid [not null]
  branch_id uuid
  department_id uuid
  employee_code varchar(50) [not null]
  designation varchar(100)
  date_of_joining date [not null]
  base_salary decimal(10,2)
  hourly_rate decimal(10,2)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp
  is_active boolean [default: true]
}

Table employee_documents {
  id uuid [primary key]
  tenant_id uuid [not null]
  employee_id uuid [not null]
  document_type varchar(100) [not null]
  document_url text [not null]
  expiry_date date
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table attendance_records {
  id uuid [primary key]
  tenant_id uuid [not null]
  employee_id uuid [not null]
  date date [not null]
  clock_in timestamp
  clock_out timestamp
  status attendance_status [not null]
  notes text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
  updated_by uuid
}

Table shifts {
  id uuid [primary key]
  tenant_id uuid [not null]
  branch_id uuid [not null]
  name varchar(100) [not null]
  start_time time [not null]
  end_time time [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp
  is_active boolean [default: true]
}

Table shift_assignments {
  id uuid [primary key]
  tenant_id uuid [not null]
  employee_id uuid [not null]
  shift_id uuid [not null]
  date date [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table leave_types {
  id uuid [primary key]
  tenant_id uuid [not null]
  name varchar(100) [not null]
  days_allowed int [not null]
  is_paid boolean [default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp
  is_active boolean [default: true]
}

Table leave_balances {
  id uuid [primary key]
  tenant_id uuid [not null]
  employee_id uuid [not null]
  leave_type_id uuid [not null]
  year int [not null]
  allocated decimal(5,2) [not null]
  used decimal(5,2) [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table leaves {
  id uuid [primary key]
  tenant_id uuid [not null]
  employee_id uuid [not null]
  leave_type_id uuid [not null]
  start_date date [not null]
  end_date date [not null]
  reason text
  status varchar(50) [not null, default: 'PENDING', note: 'PENDING, APPROVED, REJECTED']
  approved_by uuid
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

// --- Payroll ---

Table salary_structures {
  id uuid [primary key]
  tenant_id uuid [not null]
  employee_id uuid [not null]
  effective_date date [not null]
  basic_salary decimal(10,2) [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  is_active boolean [default: true]
}

Table salary_components {
  id uuid [primary key]
  tenant_id uuid [not null]
  salary_structure_id uuid [not null]
  name varchar(100) [not null]
  type varchar(50) [not null, note: 'EARNING, DEDUCTION']
  amount decimal(10,2) [not null]
  is_percentage boolean [default: false]
  percentage_value decimal(5,2)
}

Table payroll_runs {
  id uuid [primary key]
  tenant_id uuid [not null]
  month int [not null]
  year int [not null]
  status varchar(50) [not null, default: 'DRAFT', note: 'DRAFT, PROCESSED, PAID']
  total_amount decimal(12,2) [not null]
  processed_by uuid
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table payslips {
  id uuid [primary key]
  tenant_id uuid [not null]
  payroll_run_id uuid [not null]
  employee_id uuid [not null]
  basic_salary decimal(10,2) [not null]
  total_earnings decimal(10,2) [not null]
  total_deductions decimal(10,2) [not null]
  net_salary decimal(10,2) [not null]
  status varchar(50) [not null, default: 'GENERATED']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table payslip_components {
  id uuid [primary key]
  tenant_id uuid [not null]
  payslip_id uuid [not null]
  name varchar(100) [not null]
  type varchar(50) [not null]
  amount decimal(10,2) [not null]
}

// --- Expenses ---

Table expense_categories {
  id uuid [primary key]
  tenant_id uuid [not null]
  name varchar(100) [not null]
  description text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp
  is_active boolean [default: true]
}

Table expenses {
  id uuid [primary key]
  tenant_id uuid [not null]
  branch_id uuid [not null]
  category_id uuid [not null]
  amount decimal(10,2) [not null]
  expense_date date [not null]
  receipt_url text
  description text
  status expense_status [not null, default: 'PENDING']
  approved_by uuid
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
  updated_by uuid
}

Table petty_cash_funds {
  id uuid [primary key]
  tenant_id uuid [not null]
  branch_id uuid [not null]
  balance decimal(10,2) [not null, default: 0]
  custodian_id uuid [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table petty_cash_transactions {
  id uuid [primary key]
  tenant_id uuid [not null]
  fund_id uuid [not null]
  amount decimal(10,2) [not null]
  transaction_type varchar(50) [not null, note: 'TOP_UP, EXPENSE']
  description text
  expense_id uuid
  created_at timestamp [not null, default: `now()`]
  created_by uuid
}

// --- Notifications ---

Table notifications {
  id uuid [primary key]
  tenant_id uuid
  user_id uuid
  title varchar(255) [not null]
  message text [not null]
  channel notification_channel [not null]
  is_read boolean [default: false]
  read_at timestamp
  created_at timestamp [not null, default: `now()`]
}

Table notification_templates {
  id uuid [primary key]
  tenant_id uuid
  name varchar(100) [not null]
  channel notification_channel [not null]
  subject varchar(255)
  body text [not null]
  variables jsonb
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table notification_preferences {
  id uuid [primary key]
  user_id uuid [not null]
  preferences jsonb [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table push_subscriptions {
  id uuid [primary key]
  user_id uuid [not null]
  token varchar(512) [not null]
  device_type varchar(50)
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

// --- Reports ---

Table saved_reports {
  id uuid [primary key]
  tenant_id uuid [not null]
  name varchar(100) [not null]
  report_type varchar(100) [not null]
  filters jsonb
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
}

Table scheduled_reports {
  id uuid [primary key]
  tenant_id uuid [not null]
  saved_report_id uuid [not null]
  schedule_cron varchar(100) [not null]
  recipients text[] [not null]
  format varchar(50) [default: 'PDF']
  is_active boolean [default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
}

Table report_exports {
  id uuid [primary key]
  tenant_id uuid [not null]
  report_type varchar(100) [not null]
  status varchar(50) [not null, default: 'PENDING', note: 'PENDING, PROCESSING, COMPLETED, FAILED']
  file_url text
  expires_at timestamp
  created_at timestamp [not null, default: `now()`]
  created_by uuid
}

// --- Settings ---

Table restaurant_settings {
  id uuid [primary key]
  tenant_id uuid [not null, unique]
  settings jsonb [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  updated_by uuid
}

Table branch_settings {
  id uuid [primary key]
  tenant_id uuid [not null]
  branch_id uuid [not null, unique]
  settings jsonb [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  updated_by uuid
}

Table pos_settings {
  id uuid [primary key]
  tenant_id uuid [not null]
  branch_id uuid [not null]
  terminal_id varchar(100)
  settings jsonb [not null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table printer_configs {
  id uuid [primary key]
  tenant_id uuid [not null]
  branch_id uuid [not null]
  name varchar(100) [not null]
  ip_address varchar(50)
  type varchar(50) [not null, note: 'RECEIPT, KOT, LABEL']
  settings jsonb
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  is_active boolean [default: true]
}

// --- Audit & Activity ---

Table audit_logs {
  id uuid [primary key]
  tenant_id uuid
  table_name varchar(100) [not null]
  record_id uuid [not null]
  action varchar(50) [not null, note: 'INSERT, UPDATE, DELETE']
  old_data jsonb
  new_data jsonb
  ip_address varchar(45)
  user_agent text
  created_at timestamp [not null, default: `now()`]
  created_by uuid
  Note: 'Partition by created_at (monthly)'
}

Table activity_logs {
  id uuid [primary key]
  tenant_id uuid
  user_id uuid
  action varchar(255) [not null]
  module varchar(100)
  description text
  metadata jsonb
  created_at timestamp [not null, default: `now()`]
}

// --- Integrations ---

Table webhooks {
  id uuid [primary key]
  tenant_id uuid [not null]
  url text [not null]
  secret varchar(255)
  events text[] [not null]
  is_active boolean [default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table webhook_events {
  id uuid [primary key]
  tenant_id uuid [not null]
  webhook_id uuid [not null]
  event_type varchar(100) [not null]
  payload jsonb [not null]
  status varchar(50) [not null, default: 'PENDING', note: 'PENDING, SUCCESS, FAILED']
  attempts int [default: 0]
  last_attempt_at timestamp
  created_at timestamp [not null, default: `now()`]
}

Table integration_configs {
  id uuid [primary key]
  tenant_id uuid [not null]
  provider varchar(100) [not null, note: 'ZOMATO, SWIGGY, UBEREATS']
  branch_id uuid
  credentials jsonb [not null]
  settings jsonb
  is_active boolean [default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table delivery_platform_orders {
  id uuid [primary key]
  tenant_id uuid [not null]
  order_id uuid [not null]
  platform varchar(100) [not null]
  platform_order_id varchar(255) [not null]
  raw_payload jsonb
  created_at timestamp [not null, default: `now()`]
}

// --- Marketing ---

Table campaigns {
  id uuid [primary key]
  tenant_id uuid [not null]
  name varchar(255) [not null]
  channel notification_channel [not null]
  status varchar(50) [not null, default: 'DRAFT', note: 'DRAFT, SCHEDULED, RUNNING, COMPLETED']
  content text [not null]
  scheduled_at timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  created_by uuid
}

Table campaign_recipients {
  id uuid [primary key]
  tenant_id uuid [not null]
  campaign_id uuid [not null]
  customer_id uuid [not null]
  status varchar(50) [not null, default: 'PENDING', note: 'PENDING, SENT, DELIVERED, FAILED']
  sent_at timestamp
}

Table campaign_analytics {
  id uuid [primary key]
  tenant_id uuid [not null]
  campaign_id uuid [not null]
  total_sent int [default: 0]
  total_delivered int [default: 0]
  total_opened int [default: 0]
  total_clicked int [default: 0]
  updated_at timestamp [not null, default: `now()`]
}


// ==========================================
// RELATIONSHIPS (FOREIGN KEYS)
// ==========================================

// Core
Ref: subscriptions.company_id > companies.id
Ref: subscriptions.plan_id > subscription_plans.id
Ref: subscription_invoices.subscription_id > subscriptions.id
Ref: restaurants.company_id > companies.id
Ref: branches.tenant_id > restaurants.id
Ref: departments.tenant_id > restaurants.id
Ref: departments.branch_id > branches.id
Ref: users.tenant_id > restaurants.id
Ref: roles.tenant_id > restaurants.id

// Auth & RBAC
Ref: role_permissions.role_id > roles.id
Ref: role_permissions.permission_id > permissions.id
Ref: user_roles.user_id > users.id
Ref: user_roles.role_id > roles.id
Ref: user_roles.branch_id > branches.id
Ref: sessions.user_id > users.id
Ref: refresh_tokens.user_id > users.id
Ref: password_reset_tokens.user_id > users.id
Ref: api_keys.tenant_id > restaurants.id
Ref: api_keys.created_by > users.id

// Menu
Ref: categories.tenant_id > restaurants.id
Ref: categories.parent_id > categories.id
Ref: menu_items.tenant_id > restaurants.id
Ref: menu_items.category_id > categories.id
Ref: menu_item_branches.tenant_id > restaurants.id
Ref: menu_item_branches.menu_item_id > menu_items.id
Ref: menu_item_branches.branch_id > branches.id
Ref: modifier_groups.tenant_id > restaurants.id
Ref: modifiers.tenant_id > restaurants.id
Ref: modifiers.modifier_group_id > modifier_groups.id
Ref: menu_item_modifiers.tenant_id > restaurants.id
Ref: menu_item_modifiers.menu_item_id > menu_items.id
Ref: menu_item_modifiers.modifier_group_id > modifier_groups.id
Ref: combo_meals.tenant_id > restaurants.id
Ref: combo_items.tenant_id > restaurants.id
Ref: combo_items.combo_meal_id > combo_meals.id
Ref: combo_items.menu_item_id > menu_items.id
Ref: item_images.tenant_id > restaurants.id
Ref: item_images.menu_item_id > menu_items.id

// Recipe & Ingredients
Ref: ingredient_categories.tenant_id > restaurants.id
Ref: ingredients.tenant_id > restaurants.id
Ref: ingredients.category_id > ingredient_categories.id
Ref: recipes.tenant_id > restaurants.id
Ref: recipes.menu_item_id > menu_items.id
Ref: recipe_ingredients.tenant_id > restaurants.id
Ref: recipe_ingredients.recipe_id > recipes.id
Ref: recipe_ingredients.ingredient_id > ingredients.id

// Inventory
Ref: inventory_items.tenant_id > restaurants.id
Ref: inventory_items.branch_id > branches.id
Ref: inventory_items.ingredient_id > ingredients.id
Ref: inventory_transactions.tenant_id > restaurants.id
Ref: inventory_transactions.branch_id > branches.id
Ref: inventory_transactions.ingredient_id > ingredients.id
Ref: purchase_orders.tenant_id > restaurants.id
Ref: purchase_orders.branch_id > branches.id
Ref: purchase_orders.vendor_id > vendors.id
Ref: purchase_order_items.tenant_id > restaurants.id
Ref: purchase_order_items.purchase_order_id > purchase_orders.id
Ref: purchase_order_items.ingredient_id > ingredients.id
Ref: goods_received_notes.tenant_id > restaurants.id
Ref: goods_received_notes.branch_id > branches.id
Ref: goods_received_notes.purchase_order_id > purchase_orders.id
Ref: goods_received_notes.vendor_id > vendors.id
Ref: grn_items.tenant_id > restaurants.id
Ref: grn_items.grn_id > goods_received_notes.id
Ref: grn_items.ingredient_id > ingredients.id
Ref: stock_transfers.tenant_id > restaurants.id
Ref: stock_transfers.source_branch_id > branches.id
Ref: stock_transfers.destination_branch_id > branches.id
Ref: stock_transfer_items.tenant_id > restaurants.id
